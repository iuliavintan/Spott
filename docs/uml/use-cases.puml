@startuml
left to right direction
skinparam packageStyle folder
skinparam linetype ortho
skinparam shadowing false
skinparam defaultFontName Arial
skinparam nodesep 35
skinparam ranksep 60

title Spott - Use Case Diagram

actor "Unauthenticated Driver" as Guest
actor "Authenticated Driver" as Driver

rectangle "Spott System" {
  package "Account Management" {
    usecase "Register Account" as UC_Register
    usecase "Log In" as UC_Login
    usecase "Log Out" as UC_Logout
  }

  package "Saved Car Location" {
    usecase "Save Car Location" as UC_SaveLocation
    usecase "View Saved Car Location" as UC_ViewSaved
    usecase "Adjust Saved Car Location" as UC_AdjustLocation
  }

  package "Parking Spot Reporting" {
    usecase "Report Upcoming Departure" as UC_ReportLeaving
    usecase "Confirm Departure" as UC_ConfirmDeparture
    usecase "Cancel Upcoming Departure" as UC_CancelDeparture
    usecase "Report Spot Availability" as UC_ReportAvailability
  }

  package "Parking Discovery" {
    usecase "Search Nearby Parking" as UC_Search
    usecase "Filter Parking Reports" as UC_Filter
    usecase "View Parking Details" as UC_ViewDetails
    usecase "View Parking Heatmap" as UC_Heatmap
    usecase "Navigate to Parking Spot" as UC_Navigate
  }

  package "Active Search & Notifications" {
    usecase "Start Parking Search" as UC_StartSearch
    usecase "Receive Nearby Parking Alerts" as UC_ReceiveAlerts
    usecase "Stop Parking Search" as UC_StopSearch
  }
}

actor "Device Location &\nActivity Services" as LAS
actor "External Navigation\nService" as NAV
actor "Push Notification\nService" as NOTIF

' Associations indicate participation, not execution order or initiation.
Guest -- UC_Register
Guest -- UC_Login

Driver -- UC_Logout
Driver -- UC_SaveLocation
Driver -- UC_ViewSaved
Driver -- UC_AdjustLocation
Driver -- UC_ReportLeaving
Driver -- UC_ConfirmDeparture
Driver -- UC_CancelDeparture
Driver -- UC_ReportAvailability
Driver -- UC_Search
Driver -- UC_ViewDetails
Driver -- UC_Heatmap
Driver -- UC_Navigate
Driver -- UC_StartSearch
Driver -- UC_StopSearch
Driver -- UC_ReceiveAlerts

UC_SaveLocation -right- LAS
UC_ConfirmDeparture -right- LAS
UC_Search -right- LAS
UC_Navigate -right- NAV
UC_ReceiveAlerts -right- NOTIF

' Optional filtering; current product rules are in README.md.
UC_Search <.. UC_Filter : <<extend>>

' Hidden links constrain layout only; they are not UML relationships.
Guest -[hidden]-> UC_Register
Driver -[hidden]-> UC_Search
UC_Filter -[hidden]-> LAS
UC_Filter -[hidden]-> NAV
UC_Filter -[hidden]-> NOTIF

legend bottom left
  Parking and departure require driver confirmation.
  Only the author can cancel an upcoming departure.
  Occupied feedback requires a recent device location near the spot.
  Reports expire after configurable time limits.
  Active searches use a fixed, user-selected center and radius.
endlegend

@enduml
